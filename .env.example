# Connect Admin — copy to .env.local and fill in.
# NEXT_PUBLIC_* values are inlined at build time; rebuild after changing them.

# Supabase project (Settings → API). Use the anon/public key only —
# never the service-role key: every read and write goes through RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Which community this console serves (app.centers.slug). Defaults to jsh.
NEXT_PUBLIC_CENTER_SLUG=jsh
